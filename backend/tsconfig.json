{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "lib": ["esnext", "dom"], // Added 'dom' for console and other common globals
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Explicitly list ALL @types packages from your devDependencies.
    // This leaves no ambiguity for TypeScript.
    "types": [
      "node",
      "express",
      "cors",
      "jsonwebtoken",
      "multer",
      "nodemailer",
      "xmldom"
    ],
    // **CRITICAL:** Define where TypeScript should look for type definitions.
    // This ensures it finds both installed @types and your custom global declarations.
    "typeRoots": [
      "./node_modules/@types", // Standard path for installed @types packages
      "./src/types"           // Path for your custom declaration files (like custom-express.d.ts)
    ]
  },
  "include": ["src"] // This tells TypeScript to compile all .ts files in 'src'
  // If you have a global.d.ts or custom-express.d.ts that is *not* a module
  // (i.e., no top-level imports/exports), placing it in src/types and
  // having "./src/types" in typeRoots should make it work.
  // If it still gives TS2306, the file might contain an implicit module structure
  // or be compiled as a regular source file.
}