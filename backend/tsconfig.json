{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["es2020", "dom"],
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "express",
      "cors",
      "jsonwebtoken",
      "multer",
      "nodemailer",
      "xmldom"
    ],
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src"]
}
