{
  "compilerOptions": {
    "target": "ES2020", // Changed to a slightly newer target for broader compatibility
    "module": "ESNext",
    // Explicitly list all standard libs you might need. 'dom' is for console, 'es2020' for modern features.
    "lib": ["es2020", "dom"],
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // **CRITICAL:** Explicitly list ALL @types packages from your devDependencies.
    // This is the most direct way to tell TypeScript which types to include.
    "types": [
      "node",
      "express",
      "cors",
      "jsonwebtoken",
      "multer",
      "nodemailer",
      "xmldom"
    ],
    // **CRITICAL:** Define the root directories where TypeScript should look for type definition files.
    // This order prioritizes your custom types, then the standard node_modules/@types.
    "typeRoots": [
      "./src/types",           // Your custom declaration files (e.g., custom-express.d.ts)
      "./node_modules/@types"  // Standard path for installed @types packages
    ]
  },
  "include": ["src"] // This tells TypeScript to compile all .ts files within the 'src' directory.
}