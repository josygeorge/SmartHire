{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    // **FIX:** Added 'dom' to 'lib' for global types like 'console'.
    // 'esnext' covers many modern features, but 'dom' is often needed for console.
    "lib": ["esnext", "dom"],
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // **FIX:** Explicitly list ALL @types packages from your devDependencies.
    // This leaves no ambiguity for TypeScript.
    "types": [
      "node",
      "express",
      "cors",
      "jsonwebtoken",
      "multer",
      "nodemailer",
      "xmldom"
    ],
    // Keep typeRoots to point to where @types packages are installed.
    // If you have other custom global .d.ts files, they should be
    // included via 'include' or 'files' if not in node_modules/@types.
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  // Ensure 'src' is included for your source files.
  // If src/types/express/index.d.ts is causing TS2306,
  // it might be because it's in 'src' and treated as a module.
  // A common workaround is to move global .d.ts files outside 'src'
  // or ensure they don't have top-level imports/exports.
  "include": ["src"],
  "files": ["./src/global.d.ts"] // Add this if you create a global.d.ts
}